// Online C++ compiler to run C++ program online
#include <iostream>
#include<vector>
using namespace std;
int main() {
    
    cout<<" longest palindrome";
    vector<int>lower(26,0);
    vector<int>upper(26,0);
    int count =0;
    int odd=0;
    string s="aabbcccAA";
    for(int i=0;i<s.size();i++){
        if(s[i]>='a'){
            lower[s[i]-'a']++;
        }
        else{
            upper[s[i]-'A']++;
        }
    }
    
    for(int i=0;i<lower.size();i++){
        if(lower[i]%2==0){
            count+=lower[i];
        }else {
           count+= lower[i]-1;
           odd=1;
        }
        if(upper[i]%2==0){
            count+=upper[i];
        }else{
            count+=upper[i]-1;
            odd=1;
        }
    }
    cout<<"total"<<count+odd;
    
    
    return 0;
}
