  if(isalpha(s[i])){
      word +=s[i];
  }   
  else if(isdigit(s[i])){
      int num =s[i]-'0';
      words[num]=word;
      word="";
  }
 }
  // Print words in order
    for (int i = 0; i < 10; i++) {
        if (words[i] != "") {
            cout << words[i] << " ";
        }
    }
