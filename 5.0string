// Online C++ compiler to run C++ program online
#include <iostream>
#include<vector>
using namespace std;
int main() {
    
    cout<<" longest palindrome";
    vector<int>lower(26,0);
    vector<int>upper(26,0);
    int count =0;
    int odd=0;
    string s="aabbcccAA";
    for(int i=0;i<s.size();i++){
        if(s[i]>='a'){
            lower[s[i]-'a']++;
        }
        else{
            upper[s[i]-'A']++;
        }
    }
    
    for(int i=0;i<lower.size();i++){
        if(lower[i]%2==0){
            count+=lower[i];
        }else {
           count+= lower[i]-1;
           odd=1;
        }
        if(upper[i]%2==0){
            count+=upper[i];
        }else{
            count+=upper[i]-1;
            odd=1;
        }
    }
    cout<<"total"<<count+odd;

  //sort the sentence
  string s ="this2 is1 ";
  int l =s.size();
  string word="";
  string words[10];
  for(int i=0;i<l;i++){
      
  if(isalpha(s[i])){
      word +=s[i];
  }   
  else if(isdigit(s[i])){
      int num =s[i]-'0';
      words[num]=word;
      word="";
  }
 }
  // Print words in order
    for (int i = 0; i < 10; i++) {
        if (words[i] != "") {
            cout << words[i] << " ";
        }
    }
    
    
    return 0;
}
