#include <iostream>
#include<vector>
using namespace std;
int main() {
    //new logic of remove & find duplicate, 
    vector<int>arr={1,2,4,6,9,3,2,1,9,10,12,8};
    int length=arr.size();
    vector<int>newArr;
    vector<int> duplicates; 
    for(int i=0;i<length;i++){
        bool isduplicate=false;
        for(int j=0;j<newArr.size();j++){
            if(arr[i]==newArr[j]){
                isduplicate=true;
                break;
            }
        }
        if(!isduplicate){
            newArr.push_back(arr[i]);
        }else {
            // Now check if it's already recorded as a duplicate
            bool alreadyAdded = false;
            for (int k = 0; k < duplicates.size(); k++) {
                if (arr[i] == duplicates[k]) {
                    alreadyAdded = true;
                    break;
                }
            }if (!alreadyAdded) {
                duplicates.push_back(arr[i]);  // record duplicate
            }
        }
    }
    
    cout<<"remove duplicate";
    for(int k=0; k< newArr.size();k++){
        cout<<newArr[k]<<",";
    }
     // Print duplicates
     
    cout << "Duplicate elements: "<<endl;
    for (int i = 0; i < duplicates.size(); i++) {
        cout << duplicates[i] << ", ";
    }


    

    return 0;
}
