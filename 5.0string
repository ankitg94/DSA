//11factorial of the larger number;
int n=6;
vector<int>ans(1,1);
while(n>1){
    int size=ans.size();
    int carry=0;
    int res;
    for(int i=0;i<size;i++){
        res =ans[i]*n+carry;
        carry =res/10;
        ans[i]=res%10;
    }
    while(carry){
        ans.push_back(carry%10);
        carry /=10;
    }
    n--;
}


reverse(ans.begin(), ans.end());
for(int i=0;i<ans.size();i++){
    cout<<ans[i];
}
    return 0;
}
