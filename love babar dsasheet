#include <iostream>
#include<vector>
using namespace std;
int main() {
    //01-new logic of find duplicate
    vector<int>arr={1,2,4,6,9,3,2,1};
    int length=arr.size();
    vector<int>newArr;

    for(int i=0;i<length;i++){
        bool isduplicate=false;
        for(int j=0;j<newArr.size();j++){
            if(arr[i]==newArr[j]){
                isduplicate=true;
                break;
            }
        }
        if(!isduplicate){
            newArr.push_back(arr[i]);
        }
    }
    
    
    for(int k=0; k< newArr.size();k++){
        cout<<newArr[k]<<",";
    }

    return 0;
}
