//right rotation
void firstRotation(int arr[],int size){
    int last =arr[size-1];
    for(int i=size-1;i>0;i--){
        arr[i]=arr[i-1];
    }
    arr[0]=last;
}
//left Rotation
void firstleftRotation(int  arr[],int size){
      int first =arr[0];
    for(int i=0;i<size-1;i++){
       arr[i]=arr[i+1];
    }
   arr[size-1]=first;
}

void PrintArray(int arr[],int size){
    for(int i=0;i<size;i++){
       cout<<arr[i]<<" ";
    }
    cout<<endl;
    
}


